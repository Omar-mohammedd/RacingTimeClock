<Window x:Class="RacingTimeClock.Views.AddRacerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Racer"
        Width="450"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#F5F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="30,25,30,20">

            <TextBlock Text="Add Racer"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#20232A"/>

            <TextBlock Text="Enter the racer's registration information."
                       FontSize="14"
                       Foreground="#777777"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="30,0,30,10">

            <TextBlock Text="Racer ID"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#20232A"/>

            <TextBox x:Name="RacerIdTextBox"
                     Height="38"
                     FontSize="16"
                     Margin="0,5,0,18"/>

            <TextBlock Text="Name"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#20232A"/>

            <TextBox x:Name="NameTextBox"
                     Height="38"
                     FontSize="16"
                     Margin="0,5,0,18"/>

            <TextBlock Text="Year of Birth"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#20232A"/>

            <TextBox x:Name="YearOfBirthTextBox"
                     Height="38"
                     FontSize="16"
                     Margin="0,5,0,5"/>

            <TextBlock x:Name="ErrorText"
                       Text=""
                       FontSize="13"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="30,10,30,25">

            <Button Content="CANCEL"
                    Width="100"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="ADD RACER"
                    Width="120"
                    Height="42"
                    FontWeight="Bold"
                    Click="AddButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
