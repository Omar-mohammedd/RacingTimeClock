<Window x:Class="RacingTimeClock.Views.AddRacerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Racer" Height="430" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6F8">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Add New Racer" FontSize="22" FontWeight="Bold" Foreground="#20232A" Margin="0,0,0,15"/>

        <!-- Form Inputs -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Racer ID" FontSize="13" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,4"/>
            <TextBox x:Name="RacerIdTextBox" Height="36" Padding="10,6" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Full Name *" FontSize="13" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,4"/>
            <TextBox x:Name="NameTextBox" Height="36" Padding="10,6" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Year of Birth (YOB) *" FontSize="13" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,4"/>
            <TextBox x:Name="YobTextBox" Height="36" Padding="10,6" FontSize="14"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="CANCEL" Width="100" Height="40" Background="#E2E8F0" Foreground="#20232A" FontWeight="Bold" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="SAVE" Width="100" Height="40" Background="#20232A" Foreground="White" FontWeight="Bold" Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
