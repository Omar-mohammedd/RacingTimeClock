<Window x:Class="RacingTimeClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Racing Time Clock"
        Width="1200"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Navigation -->

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            Margin="18,28,18,0">

                    <TextBlock Text="RACING"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="10,0,10,0"/>

                    <TextBlock Text="TIME CLOCK"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="10,0,10,4"/>

                    <TextBlock x:Name="SeasonLabel"
                               Text="Season"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="10,0,10,30"/>


                    <Button Content="NEW RACE"
                            Height="48"
                            Margin="0,0,0,10"
                            Click="NewRace_Click"/>

                    <Button Content="RACERS"
                            Height="48"
                            Margin="0,0,0,10"
                            Click="Racers_Click"/>

                    <Button Content="RACES LOG"
                            Height="48"
                            Margin="0,0,0,10"
                            Click="RacesLog_Click"/>

                </StackPanel>


                <Button Grid.Row="1"
                        Content="SETTINGS"
                        Height="48"
                        Margin="18,10,18,22"
                        Click="Settings_Click"/>

            </Grid>

        </Border>


        <!-- Page -->

        <Border Grid.Column="1"
                Background="{DynamicResource PageBackgroundBrush}">

            <ContentControl x:Name="PageContent"/>

        </Border>

    </Grid>

</Window>
