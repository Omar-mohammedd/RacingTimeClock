<Window x:Class="RacingTimeClock.Views.RacerDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Racer Details"
        Height="760"
        Width="900"
        MinHeight="650"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Profile -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10"
                Padding="22"
                Margin="0,0,0,20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,20">

                    <TextBlock Text="RACER PROFILE"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock x:Name="RacerNameText"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Left profile column -->
                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,0,20,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Racer ID"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <TextBox x:Name="RacerIdTextBox" IsReadOnly="True"
                             Grid.Row="0"
                             Grid.Column="1"
                             Height="36"
                             Margin="0,0,0,10"
                             />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Racing Number"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <TextBox x:Name="RacingNumberTextBox" IsReadOnly="True"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="36"
                             Margin="0,0,0,10"
                             />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Gender"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ComboBox x:Name="GenderComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Height="36"
                              IsEnabled="False">
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                    </ComboBox>
                </Grid>

                <!-- Right profile column -->
                <Grid Grid.Row="1"
                      Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Year of Birth"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <ComboBox x:Name="BirthYearComboBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Height="36"
                             Margin="0,0,0,10"
                             />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Category"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock x:Name="CategoryText"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Statistics -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL RACES"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="TotalRacesText"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="VICTORIES"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="WinsText"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PODIUMS"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="PodiumsText"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Race history -->
        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="RACE HISTORY"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <DataGrid x:Name="HistoryDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      RowHeight="42"
                      FontSize="13">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Date &amp; Time"
                                        Binding="{Binding StartDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding RaceType}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Distance"
                                        Binding="{Binding Distance}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Position"
                                        Binding="{Binding PositionDisplay}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Finish Time"
                                        Binding="{Binding FormattedFinishTime}"
                                        Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="3"
              Margin="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="EditButton"
                        Content="EDIT RACER"
                        Width="120"
                        Height="42"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Click="EditButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="SAVE CHANGES"
                        Width="135"
                        Height="42"
                        Background="{DynamicResource SuccessBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="SaveButton_Click"/>

                <Button x:Name="CancelEditButton"
                        Content="CANCEL"
                        Width="100"
                        Height="42"
                        Background="{DynamicResource TextMutedBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="CancelEditButton_Click"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="DeleteButton"
                        Content="DEACTIVATE"
                        Width="120"
                        Height="42"
                        Background="{DynamicResource DangerBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Click="DeleteButton_Click"/>

                <Button Content="CLOSE"
                        Width="100"
                        Height="42"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="CloseButton_Click"/>

            </StackPanel>
        </Grid>

    </Grid>
</Window>










