<Window x:Class="RacingTimeClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Racing Time Clock"
        Width="1100"
        Height="740"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource PageBackgroundBrush}">

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="14,0,12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Grid>

                            <Border x:Name="ButtonBackground"
                                    Margin="0"
                                    Background="Transparent"
                                    CornerRadius="0,7,7,0"/>

                            <Border x:Name="ActiveIndicator"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    CornerRadius="2"/>

                            <ContentPresenter
                                Margin="14,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource SidebarHoverBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource SidebarTextHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="Tag"
                                     Value="Active">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource SidebarHoverBrush}"/>

                                <Setter TargetName="ActiveIndicator"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource SidebarTextHoverBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="180"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- Logo -->

                <StackPanel Grid.Row="0"
                            Margin="17,24,17,28">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="7"
                                VerticalAlignment="Center">

                            <TextBlock Text="◷"
                                       FontSize="17"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel Margin="9,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="RacingTime"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#F4F5F7"/>

                            <TextBlock Text="CLOCK"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,-1,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel Grid.Row="1"
                            Margin="10,0,10,0">

                    <Button x:Name="NewRaceNavButton"
                            Content="New Race"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="NewRace_Click"/>

                    <Button x:Name="RacersNavButton"
                            Content="Racers"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Racers_Click"/>

                    <Button x:Name="RacesLogNavButton"
                            Content="Races Log"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="RacesLog_Click"/>

                </StackPanel>


                <!-- Settings -->

                <Button x:Name="SettingsNavButton"
                        Grid.Row="2"
                        Content="Settings"
                        Style="{StaticResource SidebarButtonStyle}"
                        Margin="10,0,10,20"
                        Click="Settings_Click"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <Border Grid.Column="1"
                Background="{DynamicResource PageBackgroundBrush}">

            <Grid>

                <!-- Kept because MainWindow.xaml.cs updates it -->
                <TextBlock x:Name="SeasonLabel"
                           Visibility="Collapsed"/>

                <ContentControl x:Name="PageContent"/>

            </Grid>

        </Border>

    </Grid>

</Window>





