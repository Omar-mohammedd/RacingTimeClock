<Application x:Class="RacingTimeClock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Colors -->

            <SolidColorBrush x:Key="PageBackgroundBrush"
                             Color="#F4F5F7"/>

            <SolidColorBrush x:Key="SurfaceBrush"
                             Color="#FFFFFF"/>

            <SolidColorBrush x:Key="SurfaceSecondaryBrush"
                             Color="#EEF0F3"/>

            <SolidColorBrush x:Key="TextPrimaryBrush"
                             Color="#20232A"/>

            <SolidColorBrush x:Key="TextSecondaryBrush"
                             Color="#6B7280"/>

            <SolidColorBrush x:Key="TextMutedBrush"
                             Color="#777777"/>

            <SolidColorBrush x:Key="BorderBrush"
                             Color="#D9DDE2"/>

            <SolidColorBrush x:Key="AccentBrush"
                             Color="#CE1126"/>

            <SolidColorBrush x:Key="AccentHoverBrush"
                             Color="#E31B32"/>

            <SolidColorBrush x:Key="GoldBrush"
                             Color="#E5B93F"/>

            <SolidColorBrush x:Key="ButtonTextBrush"
                             Color="#FFFFFF"/>

            <SolidColorBrush x:Key="ButtonSecondaryBrush"
                             Color="#E7EAEE"/>

            <SolidColorBrush x:Key="ButtonSecondaryTextBrush"
                             Color="#20232A"/>

            <SolidColorBrush x:Key="DangerBrush"
                             Color="#C62828"/>

            <SolidColorBrush x:Key="SuccessBrush"
                             Color="#00844A"/>

            <Color x:Key="ButtonGlowColor">#CE1126</Color>


            <!-- Global Button Style -->

            <Style TargetType="{x:Type Button}">

                <Setter Property="Height"
                        Value="44"/>

                <Setter Property="MinWidth"
                        Value="110"/>

                <Setter Property="Padding"
                        Value="18,0"/>

                <Setter Property="Margin"
                        Value="0"/>

                <Setter Property="FontSize"
                        Value="14"/>

                <Setter Property="FontWeight"
                        Value="SemiBold"/>

                <Setter Property="Foreground"
                        Value="{DynamicResource ButtonTextBrush}"/>

                <Setter Property="Background"
                        Value="{DynamicResource AccentBrush}"/>

                <Setter Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}"/>

                <Setter Property="BorderThickness"
                        Value="0"/>

                <Setter Property="Cursor"
                        Value="Hand"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="{x:Type Button}">

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">

                                <Border.Effect>

                                    <DropShadowEffect
                                        Color="{DynamicResource ButtonGlowColor}"
                                        BlurRadius="12"
                                        ShadowDepth="3"
                                        Opacity="0.28"/>

                                </Border.Effect>

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="{DynamicResource AccentHoverBrush}"/>

                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="True">

                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="{DynamicResource GoldBrush}"/>

                                    <Setter Property="Foreground"
                                            Value="#20232A"/>

                                </Trigger>

                                <Trigger Property="IsEnabled"
                                         Value="False">

                                    <Setter TargetName="ButtonBorder"
                                            Property="Opacity"
                                            Value="0.45"/>

                                    <Setter Property="Cursor"
                                            Value="Arrow"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>


            <!-- Secondary Button Style -->

            <Style x:Key="SecondaryButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">

                <Setter Property="Foreground"
                        Value="{DynamicResource ButtonSecondaryTextBrush}"/>

                <Setter Property="Background"
                        Value="{DynamicResource ButtonSecondaryBrush}"/>

                <Setter Property="BorderBrush"
                        Value="{DynamicResource BorderBrush}"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

            </Style>


            <!-- Danger Button Style -->

            <Style x:Key="DangerButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">

                <Setter Property="Background"
                        Value="{DynamicResource DangerBrush}"/>

                <Setter Property="BorderBrush"
                        Value="{DynamicResource DangerBrush}"/>

            </Style>


            <!-- Global ComboBox -->


            <!-- Global TextBox -->

        </ResourceDictionary>
    </Application.Resources>

</Application>

