<Window x:Class="RacingTimeClock.Views.AddRacerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Racer"
        Height="590"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Add New Racer"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Racer ID *"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="RacerIdTextBox"
                     Height="42"
                     Padding="10,6"
                     FontSize="13"
                     MaxLength="5"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Name *"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="NameTextBox"
                     Height="42"
                     Padding="10,6"
                     FontSize="13"
                     MaxLength="20"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Year of Birth *"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <ComboBox x:Name="YobComboBox"
                      Height="42"
                      FontSize="13"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Racing Number *"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="RacingNumberTextBox"
                     Height="42"
                     Padding="10,6"
                     FontSize="13"
                     MaxLength="4"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Gender *"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <ComboBox x:Name="GenderComboBox"
                      Height="42"
                      FontSize="13">

                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>

            </ComboBox>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="CANCEL"
                    Width="100"
                    Height="42"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="SAVE"
                    Width="100"
                    Height="42"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="AddButton_Click"/>

        </StackPanel>

    </Grid>

</Window>





