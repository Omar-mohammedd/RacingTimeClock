<Window x:Class="RacingTimeClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Racing Time Clock"
        Width="1100"
        Height="740"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}">

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AEB6C0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SidebarHoverBrush}"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="180"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- Logo -->

                <StackPanel Grid.Row="0"
                            Margin="17,24,17,28">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="7"
                                VerticalAlignment="Center">

                            <TextBlock Text="◷"
                                       FontSize="17"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel Margin="9,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="RacingTime"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#F4F5F7"/>

                            <TextBlock Text="CLOCK"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,-1,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel Grid.Row="1"
                            Margin="10,0,10,0">

                    <Button x:Name="NewRaceNavButton"
                            Content="New Race"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="NewRace_Click"/>

                    <Button x:Name="RacersNavButton"
                            Content="Racers"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Racers_Click"/>

                    <Button x:Name="RacesLogNavButton"
                            Content="Races Log"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="RacesLog_Click"/>

                </StackPanel>


                <!-- Settings -->

                <Button x:Name="SettingsNavButton"
                        Grid.Row="2"
                        Content="Settings"
                        Style="{StaticResource SidebarButtonStyle}"
                        Margin="10,0,10,20"
                        Click="Settings_Click"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <Border Grid.Column="1"
                Background="{DynamicResource PageBackgroundBrush}">

            <Grid>

                <!-- Kept because MainWindow.xaml.cs updates it -->
                <TextBlock x:Name="SeasonLabel"
                           Visibility="Collapsed"/>

                <ContentControl x:Name="PageContent"/>

            </Grid>

        </Border>

    </Grid>

</Window>

