<UserControl x:Class="RacingTimeClock.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="45">

            <TextBlock Text="Settings"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock Text="Application settings and race configuration."
                       FontSize="15"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,32"/>


            <!-- Appearance -->

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="25"
                    Width="620"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Appearance"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="Choose how Racing Time Clock should appear."
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,16"/>

                    <ComboBox x:Name="ThemeComboBox"
                              Width="220"
                              HorizontalAlignment="Left"
                              SelectionChanged="ThemeComboBox_SelectionChanged">

                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="System"/>

                    </ComboBox>

                </StackPanel>

            </Border>


            <!-- Season -->

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="25"
                    Width="620"
                    HorizontalAlignment="Left">

                <StackPanel>

                    <TextBlock Text="Current Season"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="The selected season controls racer categories throughout the application."
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,16"/>

                    <ComboBox x:Name="SeasonComboBox"
                              Width="250"
                              HorizontalAlignment="Left"
                              SelectionChanged="SeasonComboBox_SelectionChanged"/>

                    <TextBlock x:Name="SeasonInfoText"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>

