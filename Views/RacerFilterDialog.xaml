<Window x:Class="RacingTimeClock.Views.RacerFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Racers"
        Width="560"
        Height="560"
        MinWidth="520"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,22">
            <TextBlock Text="FILTER RACERS"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <TextBlock Text="Narrow the racer list using the available criteria."
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="YEAR OF BIRTH FROM"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="MinBirthYearTextBox"
                                 Height="40"
                                 MaxLength="3"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="YEAR OF BIRTH TO"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="MaxBirthYearTextBox"
                                 Height="40"
                                 MaxLength="3"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GENDER"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="GenderComboBox"
                                  Height="40">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="STATUS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="StatusComboBox"
                                  Height="40">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Not Active"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,0,0,16">

                    <StackPanel>
                        <TextBlock Text="CATEGORY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="CategoryComboBox"
                                  Height="40">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Senior"/>
                            <ComboBoxItem Content="Junior"/>
                            <ComboBoxItem Content="Youth"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RACING NUMBER FROM"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="MinRacingNumberTextBox"
                                 Height="40"
                                 MaxLength="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RACING NUMBER TO"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="MaxRacingNumberTextBox"
                                 Height="40"
                                 MaxLength="6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="4"
                           Text="Enter a specific birth-year range to filter racers."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,2,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,18,0,0">

            <Button Content="RESET"
                    Width="100"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ResetButton_Click"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="CANCEL"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button Content="APPLY FILTER"
                        Width="120"
                        Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

