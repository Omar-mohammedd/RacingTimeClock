<UserControl x:Class="RacingTimeClock.Views.NewRaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F6F8">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="45">

                <TextBlock Text="New Race"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#20232A"/>

                <TextBlock Text="Set up the race before starting the clock."
                           FontSize="15"
                           Foreground="#777777"
                           Margin="0,5,0,35"/>

                <!-- Category -->

                <TextBlock Text="Category"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#20232A"
                           Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal">

                    <Button x:Name="AllCategoryButton"
                            Content="ALL"
                            Width="120"
                            Height="45"
                            Margin="0,0,10,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="AllCategoryButton_Click"/>

                    <Button x:Name="SeniorCategoryButton"
                            Content="SENIORS"
                            Width="120"
                            Height="45"
                            Margin="0,0,10,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="SeniorCategoryButton_Click"/>

                    <Button x:Name="JuniorCategoryButton"
                            Content="JUNIORS"
                            Width="120"
                            Height="45"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="JuniorCategoryButton_Click"/>

                    <Button x:Name="YouthCategoryButton"
                            Content="YOUTH"
                            Width="120"
                            Height="45"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="YouthCategoryButton_Click"/>

                </StackPanel>

                <!-- Race Type -->

                <TextBlock Text="Race Type"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#20232A"
                           Margin="0,30,0,12"/>

                <StackPanel Orientation="Horizontal">

                    <Button x:Name="ShortButton"
                            Content="SHORT"
                            Width="140"
                            Height="50"
                            Margin="0,0,10,0"
                            FontSize="15"
                            FontWeight="Bold"
                            Click="ShortButton_Click"/>

                    <Button x:Name="LongButton"
                            Content="LONG"
                            Width="140"
                            Height="50"
                            FontSize="15"
                            FontWeight="Bold"
                            Click="LongButton_Click"/>

                </StackPanel>

                <!-- Distance -->

                <TextBlock Text="Distance"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#20232A"
                           Margin="0,35,0,12"/>

                <WrapPanel x:Name="DistancePanel"/>

                <!-- Number of Racers -->

                <TextBlock Text="Number of Racers"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#20232A"
                           Margin="0,35,0,12"/>

                <WrapPanel x:Name="RacerCountPanel"/>

                <!-- Racer Selection -->

                <TextBlock Text="Select Racers"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#20232A"
                           Margin="0,35,0,12"/>

                <TextBlock Text="Choose the racer assigned to each lane."
                           FontSize="14"
                           Foreground="#777777"
                           Margin="0,0,0,12"/>

                <StackPanel x:Name="RacerSelectionPanel"
                            Width="550"
                            HorizontalAlignment="Left"/>

                <!-- Error -->

                <TextBlock x:Name="ErrorText"
                           FontSize="14"
                           Foreground="#C62828"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>

                <!-- Start -->

                <Button x:Name="StartRaceButton"
                        Content="START RACE"
                        Width="200"
                        Height="60"
                        Margin="0,30,0,45"
                        HorizontalAlignment="Left"
                        FontSize="18"
                        FontWeight="Bold"
                        Click="StartRaceButton_Click"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
