<Window x:Class="RacingTimeClock.Views.RaceDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Race Details"
        Height="620"
        Width="780"
        MinHeight="560"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="RaceTitleText"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="RaceMetaText"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DataGrid x:Name="LeaderboardDataGrid"
                      Style="{StaticResource UnifiedDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="40"
                      FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pos" Binding="{Binding PositionDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Racer ID" Binding="{Binding RacerId}" Width="120"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding FormattedFinishTime}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="2"
                Content="CLOSE"
                Width="110"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>








