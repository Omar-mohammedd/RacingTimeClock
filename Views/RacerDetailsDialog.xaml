<Window x:Class="RacingTimeClock.Views.RacerDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Racer Details"
        Height="780"
        Width="920"
        MinHeight="680"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24"
                Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,22">
                    <TextBlock Text="RACER PROFILE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="RacerNameText"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="Racer ID" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="RacerIdTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Text="Racing Number" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="RacingNumberTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Text="Gender" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="GenderComboBox" Grid.Row="2" Grid.Column="1" IsEnabled="False">
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="Year of Birth" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="BirthYearComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Text="Category" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CategoryText"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL RACES" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="TotalRacesText" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="VICTORIES" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="WinsText" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="PODIUMS" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="PodiumsText" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="RACE HISTORY"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <DataGrid x:Name="HistoryDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="40"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding StartDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding RaceType}" Width="80"/>
                        <DataGridTextColumn Header="Distance" Binding="{Binding Distance}" Width="90"/>
                        <DataGridTextColumn Header="Position" Binding="{Binding PositionDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Finish Time" Binding="{Binding FormattedFinishTime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="EditButton" Content="EDIT RACER" Width="120" Margin="0,0,10,0" Click="EditButton_Click"/>
                <Button x:Name="SaveButton" Content="SAVE CHANGES" Width="135" Background="{DynamicResource SuccessBrush}" Visibility="Collapsed" Margin="0,0,10,0" Click="SaveButton_Click"/>
                <Button x:Name="CancelEditButton" Content="CANCEL" Width="100" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Margin="0,0,10,0" Click="CancelEditButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeleteButton" Content="DEACTIVATE" Width="120" Background="{DynamicResource DangerBrush}" Margin="0,0,10,0" Click="DeleteButton_Click"/>
                <Button Content="CLOSE" Width="100" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
