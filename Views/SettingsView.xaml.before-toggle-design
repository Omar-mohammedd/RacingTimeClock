<UserControl x:Class="RacingTimeClock.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,36">

            <TextBlock Text="Settings"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock Text="Application settings and race configuration."
                       FontSize="15"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,28"/>


            <!-- ================================================= -->
            <!-- CURRENT SEASON -->
            <!-- ================================================= -->

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    MaxWidth="700"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock Text="Current Season"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="The selected season controls racer categories throughout the application."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,20"
                               TextWrapping="Wrap"/>

                    <ComboBox x:Name="SeasonComboBox"
                              Width="280"
                              HorizontalAlignment="Left"
                              SelectionChanged="SeasonComboBox_SelectionChanged"/>

                    <TextBlock x:Name="SeasonInfoText"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- FULL SCREEN -->
            <!-- ================================================= -->

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    MaxWidth="700"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock Text="Full Screen"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="Show Racing Time Clock in a maximized window."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,16"
                               TextWrapping="Wrap"/>

                    <CheckBox x:Name="FullScreenCheckBox"
                              Content="Enable Full Screen"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Checked="FullScreenCheckBox_Changed"
                              Unchecked="FullScreenCheckBox_Changed"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- APPEARANCE -->
            <!-- ================================================= -->

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    MaxWidth="700"
                    HorizontalAlignment="Left">

                <StackPanel>

                    <TextBlock Text="Appearance"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="Choose how Racing Time Clock should appear."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,20"/>


                    <TextBlock Text="Theme"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="ThemeComboBox"
                              Width="280"
                              HorizontalAlignment="Left"
                              SelectionChanged="ThemeComboBox_SelectionChanged">

                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="System"/>

                    </ComboBox>


                    <TextBlock Text="Accent Color"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,18,0,6"/>

                    <TextBlock Text="Choose the primary color used throughout the application."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <ComboBox x:Name="AccentComboBox"
                              Width="280"
                              HorizontalAlignment="Left"
                              SelectionChanged="AccentComboBox_SelectionChanged">

                        <ComboBoxItem Content="Red"/>
                        <ComboBoxItem Content="Blue"/>
                        <ComboBoxItem Content="Green"/>
                        <ComboBoxItem Content="Purple"/>
                        <ComboBoxItem Content="Orange"/>

                    </ComboBox>

                </StackPanel>

            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
