<UserControl x:Class="RacingTimeClock.Views.RacerDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RacingTimeClock.Controls"
             Background="{DynamicResource PageBackgroundBrush}"
             PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
>

    <Grid>

        
        <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- RACER PROFILE -->

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24"
                Margin="0,0,0,18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,22">

                    <TextBlock Text="RACER PROFILE"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock x:Name="RacerNameText"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,5,0,0"/>

                    <TextBox x:Name="RacerNameTextBox"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Visibility="Collapsed"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <!-- LEFT INFORMATION -->

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,0,24,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Racer ID"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="RacerIdText"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <TextBox x:Name="RacerIdTextBox" MaxLength="14"
                             Grid.Row="0"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1"
                               Text="Racing Number"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="RacingNumberText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <TextBox x:Name="RacingNumberTextBox" MaxLength="4"
                             Grid.Row="1"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2"
                               Text="Gender"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="GenderText"
                               Grid.Row="2"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <ComboBox x:Name="GenderComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Visibility="Collapsed">

                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>

                    </ComboBox>

                </Grid>

                <!-- RIGHT INFORMATION -->

                <Grid Grid.Row="1"
                      Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Year of Birth"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="BirthYearText"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <ComboBox x:Name="BirthYearComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Visibility="Collapsed"
                              Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1"
                               Text="Category"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CategoryText"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                </Grid>

            </Grid>

        </Border>

        <!-- STATISTICS -->

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL RACES"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock x:Name="TotalRacesText"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="VICTORIES"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock x:Name="WinsText"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PODIUMS"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock x:Name="PodiumsText"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- RACE HISTORY -->

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="RACE HISTORY"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">

                                                                <controls:RacingDataGrid x:Name="HistoryDataGrid"
                                          PreviewMouseDown="HistoryDataGrid_PreviewMouseDown"
                                          MouseDoubleClick="HistoryDataGrid_MouseDoubleClick">

                    <controls:RacingDataGrid.Columns>

                        <DataGridTextColumn Header="DATE &amp; TIME"
                                            Binding="{Binding StartDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                            Width="170"/>

                        <DataGridTextColumn Header="TYPE"
                                            Binding="{Binding RaceType}"
                                            Width="*"/>

                        <DataGridTextColumn Header="DISTANCE"
                                            Binding="{Binding Distance}"
                                            Width="110"/>

                        <DataGridTextColumn Header="POSITION"
                                            Binding="{Binding PositionDisplay}"
                                            Width="110"/>

                        <DataGridTextColumn Header="FINISH TIME"
                                            Binding="{Binding FormattedFinishTime}"
                                            Width="150"/>

                    </controls:RacingDataGrid.Columns>

                </controls:RacingDataGrid>

            </Border>

        </Grid>

        <!-- ACTIONS -->

        <Grid Grid.Row="3"
              Margin="0,18,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="EditButton"
                        Content="EDIT RACER"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="EditButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="SAVE CHANGES"
                        Width="135"
                        Background="{DynamicResource SuccessBrush}"
                        Visibility="Collapsed"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button x:Name="CancelEditButton"
                        Content="CANCEL"
                        Width="100"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed"
                        Margin="0,0,10,0"
                        Click="CancelEditButton_Click"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                                <Button x:Name="StatusButton" Content="DEACTIVATE" Width="120" Style="{DynamicResource RacerDangerOutlineButtonStyle}" Visibility="Collapsed" Margin="0,0,10,0" Click="StatusButton_Click"/>

                                <Button x:Name="DeletePermanentButton" Content="DELETE PERMANENTLY" Width="165" Style="{DynamicResource RacerDangerOutlineButtonStyle}" Visibility="Collapsed" Margin="0,0,10,0" Click="DeletePermanentButton_Click"/>

                <Button x:Name="CloseButton" Content="CLOSE"
                        Width="100"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

    </Grid>
    </Grid>
</UserControl>





