<UserControl x:Class="RacingTimeClock.Views.RaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,24,30,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock x:Name="RaceTitleText"
                           Text="1000m Race"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock x:Name="RaceInfoText"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right">

                <TextBlock Text="RACE TIME"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"/>

                <TextBlock x:Name="TimerText"
                           Text="00:00.000"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Right"/>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="1"
              Margin="30,0,30,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,0,0,15">

                <TextBlock x:Name="StatusText"
                           Text="PRESS SPACE TO START"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="RacersPanel"/>

            </ScrollViewer>

            <StackPanel Grid.Row="2">

                <Button x:Name="SaveRaceButton"
                        Content="SAVE RACE"
                        Width="200"
                        Height="55"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,10"
                        FontSize="13"
                        FontWeight="Bold"
                        Visibility="Collapsed"
                        Click="SaveRaceButton_Click"/>

                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="10"
                        Padding="15">

                    <TextBlock Text="SPACE = START    |    1-9 = FINISH RACER"
                               Foreground="White"
                               FontSize="13"
                               HorizontalAlignment="Center"/>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>





