<UserControl x:Class="RacingTimeClock.Views.NewRaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Prototype button style -->
        <Style x:Key="RaceChoiceButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="MinWidth"
                    Value="66"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

        </Style>

        <!-- Small secondary button -->
        <Style x:Key="SmallSecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Height"
                    Value="28"/>

            <Setter Property="MinWidth"
                    Value="62"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <!-- Stepper buttons -->
        <Style x:Key="StepperSideStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource AccentHoverBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Search box -->
        <Style x:Key="PrototypeSearchTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>

        </Style>

    </UserControl.Resources>


    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="32,24,32,24">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <Grid Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="New Race"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Text="Set up a new race"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <!-- Status -->
                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10,5">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0"/>

                            <TextBlock Text="Timing system ready"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- RACE SETUP CARD -->
                <!-- ================================================= -->

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Top row -->
                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="Race Type &amp; Distance"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <TextBlock Text="Choose the format and official race distance"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <!-- Short / Long -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="3"
                                    Height="34">

                                <Grid Width="164">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="ShortButton"
                                            Grid.Column="0"
                                            Content="Short"
                                            Height="28"
                                            BorderThickness="0"
                                            Click="ShortButton_Click"/>

                                    <Button x:Name="LongButton"
                                            Grid.Column="1"
                                            Content="Long"
                                            Height="28"
                                            BorderThickness="0"
                                            Click="LongButton_Click"/>

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- Distances -->
                        <Grid Grid.Row="1"
                              Margin="0,13,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel x:Name="DistancePanel"/>

                            <TextBlock Grid.Column="1"
                                       Text="5K · 10K · 15K"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="15,0,0,0"/>

                        </Grid>


                        <!-- Bottom row -->
                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="104"/>
                            </Grid.ColumnDefinitions>


                            <!-- Competition -->
                            <ComboBox x:Name="CompetitionComboBox"
                                      Grid.Column="0"
                                      Height="34"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="National Championship"/>
                                <ComboBoxItem Content="Classification"/>
                                <ComboBoxItem Content="League"/>
                                <ComboBoxItem Content="Cup"/>
                                <ComboBoxItem Content="National Team Qualifications"/>
                                <ComboBoxItem Content="Friendly"/>

                            </ComboBox>


                            <!-- Racer count -->
                            <Border Grid.Column="2"
                                    Height="34"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>


                                    <Border Grid.Column="0"
                                            Margin="2"
                                            CornerRadius="6"
                                            Style="{StaticResource StepperSideStyle}"
                                            MouseLeftButtonUp="DecreaseRacerCountButton_Click">

                                        <TextBlock Text="−"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <TextBlock x:Name="RacerCountText"
                                               Grid.Column="1"
                                               Text="4"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>


                                    <Border Grid.Column="2"
                                            Margin="2"
                                            CornerRadius="6"
                                            Style="{StaticResource StepperSideStyle}"
                                            MouseLeftButtonUp="IncreaseRacerCountButton_Click">

                                        <TextBlock Text="+"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- RACERS CARD -->
                <!-- ================================================= -->

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Header -->
                        <Grid Grid.Row="0">

                            <StackPanel>

                                <TextBlock Text="Racers"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <TextBlock Text="Add racers and confirm their starting order"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    Padding="9,5">

                                <TextBlock x:Name="SelectedCountText"
                                           Text="0 / 4 racers selected"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>

                            </Border>

                        </Grid>


                        <!-- Search -->
                        <Border Grid.Row="1"
                                Height="38"
                                Margin="0,16,0,12"
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>


                                <!-- Search icon -->
                                <Path Grid.Column="0"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.4"
                                      Data="M 9,9 L 12,12 M 5.5,10 A 4.5,4.5 0 1 1 5.5,1 A 4.5,4.5 0 0 1 5.5,10"/>


                                <TextBox x:Name="SearchTextBox"
                                         Grid.Column="1"
                                         Style="{StaticResource PrototypeSearchTextBoxStyle}"
                                         VerticalContentAlignment="Center"
                                         Text="Search for player"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         GotFocus="SearchTextBox_GotFocus"
                                         LostFocus="SearchTextBox_LostFocus"
                                         TextChanged="SearchTextBox_TextChanged"/>


                                <ComboBox x:Name="RacerPickerComboBox"
                                          Grid.Column="2"
                                          Margin="0,3,3,3"
                                          Height="30"
                                          SelectedIndex="0"
                                          SelectionChanged="RacerPickerComboBox_SelectionChanged"/>

                            </Grid>

                        </Border>


                        <!-- Table header -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="7,7,0,0"
                                Padding="10,0">

                            <Grid Height="30">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="START ORDER"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="NAME"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="RACING NUMBER"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="ACTION"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <!-- Dynamic rows -->
                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,7,7"
                                Padding="0">

                            <ScrollViewer MaxHeight="260"
                                          VerticalScrollBarVisibility="Auto">

                                <StackPanel x:Name="RacerTablePanel"/>

                            </ScrollViewer>

                        </Border>

                    </Grid>

                </Border>


                <!-- Error -->
                <TextBlock x:Name="ErrorText"
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="2,0,2,8"/>


                <!-- Start -->
                <Button x:Name="StartRaceButton"
                        Content="START RACE"
                        Height="46"
                        HorizontalAlignment="Stretch"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="StartRaceButton_Click"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>




