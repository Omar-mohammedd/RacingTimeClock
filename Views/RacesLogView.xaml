<UserControl x:Class="RacingTimeClock.Views.RacesLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->

        <Grid Grid.Row="0"
              Margin="30,24,30,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Races Log"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="Previously saved races."
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1">

                <TextBlock Text="SEASON"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="SeasonComboBox"
                          Height="42"
                          SelectionChanged="SeasonComboBox_SelectionChanged"
                          TextSearch.TextPath="Name">

                    <ComboBox.ItemTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                        </DataTemplate>

                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>

        </Grid>

        <!-- COMPLETE TABLE -->

        <Border Grid.Row="1"
                Margin="30,0,30,30"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TABLE HEADER -->

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0">
                            <TextBlock Text="RACE DISTANCE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0">
                            <TextBlock Text="AGE CATEGORY"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0">
                            <TextBlock Text="WINNER"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="3"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0">
                            <TextBlock Text="TIME"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0">
                            <TextBlock Text="SEASON"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="5">
                            <TextBlock Text="COMPETITION"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                    </Grid>

                </Border>

                <!-- TABLE BODY -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="RacesPanel"/>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>



